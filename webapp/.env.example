# Deploy stage — drives chain, contracts, wallet + migration availability.
#   content  public narrative site, no wallet (default)
#   testnet  Sepolia rehearsal: gated until every deployment value below is set
#   mainnet  Ethereum: wallet on; migration gated until every mainnet value is set
NEXT_PUBLIC_SITE_STAGE=content
# Canonical HTTPS origin used for social metadata, e.g. https://next.expansionpunks.com
NEXT_PUBLIC_SITE_URL=

# Testnet (Sepolia) contract addresses — set from deployment-data/testnet/addresses-v2.json
# after each deploy/redeploy wave (they rotate on every rewards/token redeploy).
# No rehearsal address is built into the app; incomplete configuration fails closed.
NEXT_PUBLIC_SEPOLIA_LEGACY=
NEXT_PUBLIC_SEPOLIA_CURRENT=
NEXT_PUBLIC_SEPOLIA_REWARDS=
NEXT_PUBLIC_SEPOLIA_RENDERER=
# Block the testnet mock was deployed at (event-scan start for inventory).
NEXT_PUBLIC_SEPOLIA_FROM_BLOCK=

# RPC endpoints. No key is committed; each falls back to the chain's public RPC when unset.
# Local anvil dry-run: set this to http://127.0.0.1:8545 (use 127.0.0.1, NOT localhost —
# anvil binds IPv4 only and the browser resolves "localhost" to IPv6, so reads silently fail).
# Restart the dev server after changing this (NEXT_PUBLIC_* inline at startup, not on reload).
NEXT_PUBLIC_SEPOLIA_RPC_URL=
# A dedicated HTTPS mainnet RPC is required before migration can be enabled.
NEXT_PUBLIC_MAINNET_RPC_URL=
# Enables the interactive verifier against the deployed mainnet Renderer.
NEXT_PUBLIC_MAINNET_RENDERER_ADDRESS=

# Mainnet launch configuration. Migration stays gated until the migration,
# rewards, Renderer, deployment block, RPC, and public Merkle URL are all valid.
NEXT_PUBLIC_MAINNET_MIGRATION_ADDRESS=
# Block the mainnet migration contract was deployed at (for ownership event scans).
NEXT_PUBLIC_MAINNET_FROM_BLOCK=
NEXT_PUBLIC_MAINNET_REWARDS=
# Public URL for the production Merkle file. Claims stay fail-closed when unset
# or when its root/pool do not match the deployed RewardsDistributor.
NEXT_PUBLIC_MAINNET_MERKLE_URL=
